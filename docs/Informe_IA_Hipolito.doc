  <pre>
  # Ejemplo (conceptual) para ejecutar llama.cpp con un modelo GGUF
  ./main -m modelo.gguf -p "Hola, ¿cómo estás?" -t 8 -n 128

  # Conversión/quantización (herramientas comunitarias; adaptar según versión)
